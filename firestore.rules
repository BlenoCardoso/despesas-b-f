rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Funções auxiliares
    function isSignedIn() {
      return request.auth != null;
    }

    function isCurrentUser(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isHouseholdMember(householdId) {
      return isSignedIn() && 
        exists(/databases/$(database)/documents/households/$(householdId)) &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    // Users - permitir leitura global e escrita do próprio perfil
    match /users/{userId} {
      allow read: if isSignedIn();
      allow create, update: if isCurrentUser(userId);
      allow delete: if false;
    }

    // Households - acesso baseado em membership
    match /households/{householdId} {
      allow read: if isHouseholdMember(householdId);
      allow create: if isSignedIn();
      allow update: if isHouseholdMember(householdId);
      allow delete: if isSignedIn() && 
        resource.data.ownerId == request.auth.uid;
    }

    // Expenses - acesso baseado em membership da household
    match /expenses/{expenseId} {
      allow read: if isSignedIn() && 
        isHouseholdMember(resource.data.householdId);
      allow create: if isSignedIn() && 
        isHouseholdMember(request.resource.data.householdId);
      allow update: if isSignedIn() && 
        isHouseholdMember(resource.data.householdId);
      allow delete: if isSignedIn() && 
        (isHouseholdMember(resource.data.householdId) && 
         resource.data.createdBy == request.auth.uid);
    }

    // Invites - acesso público para leitura, criação por membros
    match /invites/{inviteId} {
      allow read: if true; // Público para permitir aceitar convites
      allow create: if isSignedIn() && 
        isHouseholdMember(request.resource.data.householdId);
      allow update: if isSignedIn(); // Permitir marcar como usado
      allow delete: if isSignedIn() && 
        request.auth.uid == resource.data.createdBy;
    }

    // Permitir acesso de leitura para configurações globais
    match /config/{configId} {
      allow read: if true;
      allow write: if false;
    }

    // Negar acesso a qualquer outra coleção não especificada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}