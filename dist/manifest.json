{
  "name": "Despesas Compartilhadas",
  "short_name": "Despesas",
  "description": "Aplicativo para gerenciar despesas compartilhadas, tarefas, documentos, remédios e calendário",
  "start_url": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "orientation": "portrait-primary",
  "scope": "/",
  "lang": "pt-BR",
  "categories": ["finance", "productivity", "utilities"],
  "icons": [
    {
      "src": "/favicon.ico",
      "sizes": "64x64 32x32 24x24 16x16",
      "type": "image/x-icon"
    }
  ],
  "shortcuts": [
    {
      "name": "Nova Despesa",
      "short_name": "Despesa",
      "description": "Adicionar uma nova despesa",
      "url": "/expenses?action=new"
    },
    {
      "name": "Nova Tarefa",
      "short_name": "Tarefa",
      "description": "Adicionar uma nova tarefa",
      "url": "/tasks?action=new"
    },
    {
      "name": "Remédios",
      "short_name": "Remédios",
      "description": "Ver remédios e tomadas",
      "url": "/medications"
    },
    {
      "name": "Calendário",
      "short_name": "Calendário",
      "description": "Ver eventos do calendário",
      "url": "/calendar"
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-wide.png",
      "sizes": "1280x720",
      "type": "image/png",
      "form_factor": "wide",
      "label": "Tela principal do aplicativo"
    },
    {
      "src": "/screenshot-narrow.png",
      "sizes": "360x640",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "Versão mobile do aplicativo"
    }
  ],
  "related_applications": [],
  "prefer_related_applications": false,
  "edge_side_panel": {
    "preferred_width": 400
  },
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "handle_links": "preferred",
  "protocol_handlers": [
    {
      "protocol": "web+despesas",
      "url": "/?action=%s"
    }
  ]
}

