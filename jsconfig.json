// tsconfig.json
{
  "compilerOptions": {
    "jsx": "react-jsx",
    "baseUrl": "./",
    "paths": { "@/*": ["src/*"] },
    "strict": true
  },
  "include": ["src", "types"],
  "exclude": [
    "node_modules",
    "dist",
    "build",
    "out",
    ".vite",
    ".turbo",
    ".cache",
    ".parcel-cache",
    "coverage",
    ".next",
    ".nuxt",
    "android",
    "ios",
    ".expo",
    ".gradle"
  ]
}
